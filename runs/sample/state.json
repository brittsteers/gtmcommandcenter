  "risks": {
    "risks": [
      {
        "id": "R1",
        "title": "Asia-Pacific publishes before the embargo lifts",
        "severity": "high",
        "teams": [
          "Regional",
          "PR"
        ],
        "evidence": "Embargo lifts 2027-03-10 09:00 PT (17:00 UTC). Regional publishes at 09:00 local: Tokyo is 00:00 UTC on 03-10 and Sydney is 22:00 UTC on 03-09, so they go live 17 and 19 hours early (REG-5 vs PR-6).",
        "mitigation": "Hold APAC publish until 2027-03-11 02:00 JST / 04:00 AEDT, or move the embargo earlier for all regions. Decide by 2027-02-20.",
        "owner": "Regional Marketing Lead"
      },
      {
        "id": "R2",
        "title": "Legal review finishes after copy lock",
        "severity": "high",
        "teams": [
          "PR",
          "Legal",
          "Regional"
        ],
        "evidence": "PR-2 submits claims 2027-02-22. Ten business days puts LEG-2 at 2027-03-08, three days after copy lock (PR-5, 03-05). REG-1 translation waits on locked copy.",
        "mitigation": "Move PR-2 submission to 2027-02-15 (the Planner date) so approval lands 03-01; pre-clear the top 5 claims in a fast-track review.",
        "owner": "Comms Lead"
      },
      {
        "id": "R3",
        "title": "Press release claims browser availability on launch day",
        "severity": "high",
        "teams": [
          "PR",
          "Product"
        ],
        "evidence": "Draft says 'available in the browser today' but PRD-4 ships 2027-03-17, one week after launch.",
        "mitigation": "Change copy to 'coming to the browser next week', or pull PRD-4 into the launch date if Product confirms feasibility.",
        "owner": "Comms Lead"
      },
      {
        "id": "R4",
        "title": "Creators get access before red team sign-off",
        "severity": "medium",
        "teams": [
          "Product"
        ],
        "evidence": "PRD-1 opens early access 2027-02-01; PRD-2 red team sign-off is 2027-02-08. Creators would use an unsigned-off model for a week.",
        "mitigation": "Open early access 2027-02-09, or give creators a red-teamed checkpoint only.",
        "owner": "EA Program Lead"
      },
      {
        "id": "R5",
        "title": "No owner for localized safety disclaimers",
        "severity": "medium",
        "teams": [
          "Regional",
          "Legal"
        ],
        "evidence": "REG-3 owner is TBD. It depends on LEG-3 (02-19) and must finish by 03-08 for 14 regions.",
        "mitigation": "Assign a Regional PMM owner this week and pair with Policy Counsel.",
        "owner": "Regional Marketing Lead"
      },
      {
        "id": "R6",
        "title": "Two days for translation across 14 regions",
        "severity": "low",
        "teams": [
          "Regional"
        ],
        "evidence": "REG-1 starts 03-05 and REG-2 is due 03-08. Tight but feasible if R2 is fixed and source copy is final.",
        "mitigation": "Pre-translate non-claim copy from the 03-01 draft.",
        "owner": "Regional PMM"
      }
    ]
  },
